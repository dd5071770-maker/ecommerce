   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "np.random.seed(42)\n",
    "\n",
    "n = 1000\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    \"Order_ID\": range(1, n+1),\n",
    "    \"Customer_ID\": np.random.randint(1000, 1100, n),\n",
    "    \"Category\": np.random.choice(\n",
    "        [\"Electronics\", \"Fashion\", \"Home\", \"Beauty\", \"Sports\"],\n",
    "        n\n",
    "    ),\n",
    "    \"Price\": np.random.randint(200, 10000, n),\n",
    "    \"Discount\": np.random.randint(0, 50, n),\n",
    "    \"Delivery_Days\": np.random.randint(1, 15, n),\n",
    "    \"Rating\": np.random.randint(1, 6, n)\n",
    "})\n",
    "\n",
    "# Return logic\n",
    "df[\"Returned\"] = np.where(\n",
    "    (df[\"Delivery_Days\"] > 8) |\n",
    "    (df[\"Rating\"] <= 2),\n",
    "    \"Yes\",\n",
    "    \"No\"\n",
    ")\n",
    "\n",
    "df.to_csv(\"ecommerce_returns.csv\", index=False)\n",
    "\n",
    "print(\"Dataset Created Successfully!\")\n",
    "print(df.head())"
   ]
  },
