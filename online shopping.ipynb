   "source": [
    "Q1 = df[\"Price\"].quantile(0.25)\n",
    "Q3 = df[\"Price\"].quantile(0.75)\n",
    "\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "lower_bound = Q1 - 1.5 * IQR\n",
    "upper_bound = Q3 + 1.5 * IQR\n",
    "\n",
    "outliers = df[\n",
    "    (df[\"Price\"] < lower_bound) |\n",
    "    (df[\"Price\"] > upper_bound)\n",
    "]\n",
    "\n",
    "print(\"Number of Outliers:\", len(outliers))\n",
    "outliers.head()"
   ]
  },
